    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^11.16.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "hono-rate-limiter": "^0.5.4",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
