# Copiar a .env y completar. NUNCA commitear .env (está en .gitignore).

# --- Base de datos ---
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- App ---
# URL pública. La API vive en APP_URL/api (mismo origen que la web).
APP_URL=http://localhost:5173
# Orígenes extra permitidos (app móvil, otro dominio). Separados por coma. Opcional.
EXTRA_ORIGINS=
# true si la API corre detrás de Caddy/Nginx/Cloudflare (para leer la IP real del cliente).
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120

# --- Auth (Better Auth) ---
# Generar con: openssl rand -base64 32   (uno distinto por entorno)
BETTER_AUTH_SECRET=
# Rechazar contraseñas filtradas (consulta k-anonymity a haveibeenpwned).
AUTH_CHECK_PWNED_PASSWORDS=true

# --- Mail ---
# Dev: Mailpit (docker compose). Prod: SMTP del proveedor (Resend, Brevo, SES…).
SMTP_URL=smtp://localhost:1025
MAIL_FROM="App <no-reply@localhost>"

# --- Observabilidad (opcional) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
